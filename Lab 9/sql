-- Part A: Schema for Self Join (Employees and Managers)
CREATE TABLE Employees_SelfJoin (
    EmployeeID INT AUTO_INCREMENT PRIMARY KEY,
    EmployeeName VARCHAR(100) NOT NULL,
    Designation VARCHAR(50) NOT NULL,
    ManagerID INT,
    CONSTRAINT FK_Manager FOREIGN KEY (ManagerID) REFERENCES Employees_SelfJoin(EmployeeID)
        ON DELETE SET NULL
);

