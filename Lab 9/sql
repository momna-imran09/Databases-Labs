-- ====================================================================
-- 4. LAB QUERIES: SELF JOIN & MULTI-TABLE JOINS
-- ====================================================================

-- Query 1: SELF JOIN
-- Retrieve each employee's name along with their respective manager's name.
SELECT 
    e.EmployeeName AS Employee,
    e.Designation,
    COALESCE(m.EmployeeName, 'Top Level Management') AS ManagerName
FROM Employees_SelfJoin e
LEFT JOIN Employees_SelfJoin m ON e.ManagerID = m.EmployeeID;

-- Query 2: MULTI-TABLE JOIN (Joining 3 tables: Students, Enrollments, Courses)
-- Retrieve student registration numbers, names, the courses they are enrolled in, and grades.
SELECT 
    s.RegistrationNo,
    s.StudentName,
    c.CourseCode,
    c.CourseTitle,
    e.Semester,
    e.Grade
FROM Students_Lab9 s
INNER JOIN Enrollments_Lab9 e ON s.StudentID = e.StudentID
INNER JOIN Courses_Lab9 c ON e.CourseID = c.CourseID;

-- Query 3: COMBINED CHALLENGE QUERY
-- Retrieve specific enrollment details combined with filtering (e.g., student 2024-SE-33)
SELECT 
    s.RegistrationNo,
    s.StudentName,
    c.CourseTitle,
    e.Grade
FROM Students_Lab9 s
INNER JOIN Enrollments_Lab9 e ON s.StudentID = e.StudentID
INNER JOIN Courses_Lab9 c ON e.CourseID = c.CourseID
WHERE s.RegistrationNo = '2024-SE-33';
