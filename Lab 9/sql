-- Part B: Schema for Multi-table Joins (Students, Courses, Enrollments)
CREATE TABLE Students_Lab9 (
    StudentID INT AUTO_INCREMENT PRIMARY KEY,
    RegistrationNo VARCHAR(20) NOT NULL,
    StudentName VARCHAR(100) NOT NULL
);

CREATE TABLE Courses_Lab9 (
    CourseID INT AUTO_INCREMENT PRIMARY KEY,
    CourseCode VARCHAR(15) NOT NULL,
    CourseTitle VARCHAR(100) NOT NULL
);

CREATE TABLE Enrollments_Lab9 (
    EnrollmentID INT AUTO_INCREMENT PRIMARY KEY,
    StudentID INT NOT NULL,
    CourseID INT NOT NULL,
    Semester VARCHAR(20) NOT NULL,
    Grade VARCHAR(2) NOT NULL,
    CONSTRAINT FK_Enrolled_Student FOREIGN KEY (StudentID) REFERENCES Students_Lab9(StudentID) ON DELETE CASCADE,
    CONSTRAINT FK_Enrolled_Course FOREIGN KEY (CourseID) REFERENCES Courses_Lab9(CourseID) ON DELETE CASCADE
);

