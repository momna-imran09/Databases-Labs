-- ====================================================================
-- 4. LAB QUERIES: COMPARISON & LOGICAL OPERATORS
-- ====================================================================

-- Query 1: Using Equal To (=) operator
-- Find all employees working in the 'Software Engineering' department
SELECT * 
FROM Employees 
WHERE Department = 'Software Engineering';

-- Query 2: Using Not Equal To (<> or !=) operator
-- Find all employees whose department is NOT 'Computer Science'
SELECT * 
FROM Employees 
WHERE Department <> 'Computer Science';

-- Query 3: Using Greater Than (>) operator
-- Find employees with a salary strictly greater than 100,000
SELECT FullName, Department, Salary 
FROM Employees 
WHERE Salary > 100000.00;

-- Query 4: Using AND operator
-- Find employees in 'Software Engineering' who have experience >= 4 years
SELECT * 
FROM Employees 
WHERE Department = 'Software Engineering' 
  AND ExperienceYears >= 4;

-- Query 5: Using OR operator
-- Find employees who work in 'Computer Science' OR have a salary greater than 130,000
SELECT * 
FROM Employees 
WHERE Department = 'Computer Science' 
   OR Salary > 130000.00;

-- Query 6: Using NOT operator combined with comparison
-- Find employees whose city is NOT 'Lahore'
SELECT FullName, Department, City 
FROM Employees 
WHERE NOT (City = 'Lahore');

-- Query 7: Complex combination of AND, OR, and Comparison operators
-- Find employees from Lahore OR Islamabad who earn more than 100,000
SELECT FullName, Department, Salary, City 
FROM Employees 
WHERE (City = 'Lahore' OR City = 'Islamabad') 
  AND Salary > 100000.00;
