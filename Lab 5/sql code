-- ====================================================================
-- PART B: CONVERSION TO THIRD NORMAL FORM (3NF)
-- ====================================================================
-- Problem: A Students table where StudentID -> DeptID -> DeptName & Building.
-- Here, DeptName and Building depend on DeptID (a non-key attribute), 
-- creating a Transitive Dependency.
-- Solution: Split into Departments_3NF and Students_3NF.

-- 1. Create Departments Table (Primary Key: DeptID)
CREATE TABLE Departments_3NF (
    DeptID INT PRIMARY KEY,
    DeptName VARCHAR(100) NOT NULL,
    BuildingLocation VARCHAR(50) NOT NULL
);

-- 2. Create Students Table (Primary Key: StudentID, Foreign Key: DeptID)
CREATE TABLE Students_3NF (
    StudentID INT PRIMARY KEY,
    RegistrationNo VARCHAR(20) UNIQUE NOT NULL,
    StudentName VARCHAR(100) NOT NULL,
    DeptID INT,
    CONSTRAINT FK_Student_Dept FOREIGN KEY (DeptID) REFERENCES Departments_3NF(DeptID)
        ON DELETE SET NULL
);

