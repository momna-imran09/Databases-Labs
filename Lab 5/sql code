-- 1. Create and Select Database
CREATE DATABASE IF NOT EXISTS lab05_normalization_2nf_3nf;
USE lab05_normalization_2nf_3nf;

-- 2. Drop existing tables in correct dependency order if re-running
DROP TABLE IF EXISTS Enrollments_2NF;
DROP TABLE IF EXISTS Courses_2NF;
DROP TABLE IF EXISTS Students_3NF;
DROP TABLE IF EXISTS Departments_3NF;

-- ====================================================================
-- PART A: CONVERSION TO SECOND NORMAL FORM (2NF)
-- ====================================================================
-- Problem: A table with a composite primary key (StudentID, CourseID) 
-- where CourseName and Instructor depend ONLY on CourseID (Partial Dependency).
-- Solution: Decompose into Courses_2NF and Enrollments_2NF.

-- 1. Create Lookup Table for Courses (Fully dependent on CourseID)
CREATE TABLE Courses_2NF (
    CourseID INT PRIMARY KEY,
    CourseName VARCHAR(100) NOT NULL,
    InstructorName VARCHAR(100) NOT NULL
);

-- 2. Create Enrollments Table (Composite Key with attributes dependent on the whole key)
CREATE TABLE Enrollments_2NF (
    StudentID INT,
    CourseID INT,
    Semester VARCHAR(20),
    Grade VARCHAR(2),
    PRIMARY KEY (StudentID, CourseID),
    CONSTRAINT FK_Enroll_Course FOREIGN KEY (CourseID) REFERENCES Courses_2NF(CourseID) 
        ON DELETE CASCADE
);

