-- ====================================================================
-- PART C: VERIFICATION QUERIES
-- ====================================================================

-- Query 1: Verify 2NF decomposition (Fetch student enrollments with course details)
SELECT 
    e.StudentID,
    c.CourseID,
    c.CourseName,
    c.InstructorName,
    e.Semester,
    e.Grade
FROM Enrollments_2NF e
INNER JOIN Courses_2NF c ON e.CourseID = c.CourseID;

-- Query 2: Verify 3NF decomposition (Fetch student details with normalized department data)
SELECT 
    s.RegistrationNo,
    s.StudentName,
    d.DeptName,
    d.BuildingLocation
FROM Students_3NF s
INNER JOIN Departments_3NF d ON s.DeptID = d.DeptID;
