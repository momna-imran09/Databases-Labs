-- ====================================================================
-- 4. LAB QUERIES: STRING FUNCTIONS IN ACTION
-- ====================================================================

-- Query 1: UPPER() and LOWER() Casing Functions
-- Convert full names to uppercase and emails to lowercase
SELECT 
    RegistrationNo,
    UPPER(FullName) AS UppercaseName,
    LOWER(Email) AS LowercaseEmail
FROM Users_StringLab;

-- Query 2: CONCAT() Function
-- Combine registration number and full name into a single formatted description string
SELECT 
    CONCAT(RegistrationNo, ' - ', FullName) AS StudentIdentifier
FROM Users_StringLab;

-- Query 3: LENGTH() and CHAR_LENGTH() Functions
-- Measure string byte length and character length
SELECT 
    FullName,
    CHAR_LENGTH(FullName) AS CharacterCount,
    LENGTH(FullName) AS ByteLength
FROM Users_StringLab;

-- Query 4: SUBSTRING() Function
-- Extract the first 3 characters of the registration number (e.g., degree batch/prefix)
SELECT 
    RegistrationNo,
    SUBSTRING(RegistrationNo, 1, 4) AS BatchYearPrefix
FROM Users_StringLab;

-- Query 5: REPLACE() Function
-- Replace the university email domain suffix with a custom test domain
SELECT 
    Email,
    REPLACE(Email, 'university.edu.pk', 'customdomain.com') AS ModifiedEmail
FROM Users_StringLab;

-- Query 6: TRIM() Function
-- Remove unwanted leading and trailing spaces from CityText and FullName
SELECT 
    CityText AS OriginalCity,
    TRIM(CityText) AS CleanedCity
FROM Users_StringLab;
