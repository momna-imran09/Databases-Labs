-- 1. Create and Select Database
CREATE DATABASE IF NOT EXISTS lab10_string_functions;
USE lab10_string_functions;

-- 2. Drop table if re-running script
DROP TABLE IF EXISTS Users_StringLab;

-- ====================================================================
-- 3. CREATE SCHEMA & INSERT SAMPLE DATA
-- ====================================================================

CREATE TABLE Users_StringLab (
    UserID INT AUTO_INCREMENT PRIMARY KEY,
    RegistrationNo VARCHAR(20) NOT NULL,
    FullName VARCHAR(100) NOT NULL,
    Email VARCHAR(100) NOT NULL,
    CityText VARCHAR(50) NOT NULL
);

