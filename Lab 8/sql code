DROP TABLE IF EXISTS Departments_JoinLab;

-- ====================================================================
-- 3. CREATE SCHEMA & INSERT SAMPLE DATA
-- ====================================================================

-- Parent Table: Departments
CREATE TABLE Departments_JoinLab (
    DepartmentID INT AUTO_INCREMENT PRIMARY KEY,
    DeptCode VARCHAR(10) NOT NULL,
    DeptName VARCHAR(100) NOT NULL
);

-- Child Table: Students (Includes unassigned students to test outer joins)
CREATE TABLE Students_JoinLab (
    StudentID INT AUTO_INCREMENT PRIMARY KEY,
    RegistrationNo VARCHAR(20) NOT NULL,
    StudentName VARCHAR(100) NOT NULL,
    DepartmentID INT,
    CONSTRAINT FK_Student_DeptLab FOREIGN KEY (DepartmentID) 
        REFERENCES Departments_JoinLab(DepartmentID)
        ON DELETE SET NULL
);

