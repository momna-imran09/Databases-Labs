-- ====================================================================
-- 4. LAB QUERIES: INNER, LEFT, AND RIGHT JOINS
-- ====================================================================

-- Query 1: INNER JOIN
-- Returns only students who are successfully assigned to an existing department.
-- (Ali Unassigned and Electrical Engineering will be excluded).
SELECT 
    s.RegistrationNo,
    s.StudentName,
    d.DeptName
FROM Students_JoinLab s
INNER JOIN Departments_JoinLab d ON s.DepartmentID = d.DepartmentID;

-- Query 2: LEFT JOIN
-- Returns ALL students from the left table (Students), even if they do not belong 
-- to any department (e.g., Ali Unassigned will show NULL for department name).
SELECT 
    s.RegistrationNo,
    s.StudentName,
    COALESCE(d.DeptName, 'No Department Assigned') AS DepartmentName
FROM Students_JoinLab s
LEFT JOIN Departments_JoinLab d ON s.DepartmentID = d.DepartmentID;

-- Query 3: RIGHT JOIN
-- Returns ALL departments from the right table (Departments), even if no students 
-- are enrolled in them (e.g., Electrical Engineering will show NULL for student name).
SELECT 
    COALESCE(s.RegistrationNo, 'N/A') AS RegistrationNo,
    COALESCE(s.StudentName, 'No Students Enrolled') AS StudentName,
    d.DeptName
FROM Students_JoinLab s
RIGHT JOIN Departments_JoinLab d ON s.DepartmentID = d.DepartmentID;
