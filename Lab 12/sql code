-- ====================================================================
-- 4. LAB QUERIES: AGGREGATE FUNCTIONS IN ACTION
-- ====================================================================

-- Query 1: COUNT() Function
-- Count the total number of grade records stored in the table
SELECT 
    COUNT(*) AS TotalRecordsCount 
FROM Student_Grades_AggLab;

-- Query 2: SUM() and AVG() Functions
-- Find the total marks accumulated and the average marks scored by student 2024-SE-33
SELECT 
    RegistrationNo,
    StudentName,
    SUM(ObtainedMarks) AS TotalMarksSum,
    AVG(ObtainedMarks) AS AverageMarks
FROM Student_Grades_AggLab
WHERE RegistrationNo = '2024-SE-33'
GROUP BY RegistrationNo, StudentName;

-- Query 3: MAX() and MIN() Functions
-- Find the highest and lowest marks recorded across all courses
SELECT 
    MAX(ObtainedMarks) AS HighestMarkRecorded,
    MIN(ObtainedMarks) AS LowestMarkRecorded
FROM Student_Grades_AggLab;

-- Query 4: GROUP BY Clause
-- Calculate the average obtained marks for each department
SELECT 
    Department,
    COUNT(RegistrationNo) AS TotalAssessments,
    AVG(ObtainedMarks) AS DepartmentAverageMarks
FROM Student_Grades_AggLab
GROUP BY Department;

-- Query 5: GROUP BY with HAVING Clause
-- Find departments where the average student marks exceed 80.00
SELECT 
    Department,
    AVG(ObtainedMarks) AS DepartmentAverage
FROM Student_Grades_AggLab
GROUP BY Department
HAVING AVG(ObtainedMarks) > 80.00;
