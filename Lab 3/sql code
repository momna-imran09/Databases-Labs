DROP TABLE IF EXISTS Enrollments;
DROP TABLE IF EXISTS Students;
DROP TABLE IF EXISTS Courses;
DROP TABLE IF EXISTS Departments;

-- ====================================================================
-- 3. SCHEMA DEFINITION & KEYS IMPLEMENTATION (DDL)
-- ====================================================================

-- Table 1: Departments
-- Demonstrates: Primary Key (DepartmentID) & Unique Key (DeptCode)
CREATE TABLE Departments (
    DepartmentID INT AUTO_INCREMENT,
    DeptCode VARCHAR(10) NOT NULL,
    DeptName VARCHAR(100) NOT NULL,
    Location VARCHAR(100),
    CONSTRAINT PK_Departments PRIMARY KEY (DepartmentID),
    CONSTRAINT UQ_DeptCode UNIQUE (DeptCode)
);

-- Table 2: Courses
-- Demonstrates: Primary Key (CourseID) & Unique Key (CourseCode)
CREATE TABLE Courses (
    CourseID INT AUTO_INCREMENT,
    CourseCode VARCHAR(15) NOT NULL,
    CourseTitle VARCHAR(120) NOT NULL,
    CreditHours INT NOT NULL CHECK (CreditHours > 0),
    CONSTRAINT PK_Courses PRIMARY KEY (CourseID),
    CONSTRAINT UQ_CourseCode UNIQUE (CourseCode)
);

-- Table 3: Students
-- Demonstrates:
-- - Primary Key: StudentID
-- - Candidate / Unique Keys: RegistrationNo, Email
-- - Foreign Key: DepartmentID referencing Departments(DepartmentID)
CREATE TABLE Students (
    StudentID INT AUTO_INCREMENT,
    RegistrationNo VARCHAR(20) NOT NULL,
    FirstName VARCHAR(50) NOT NULL,
    LastName VARCHAR(50) NOT NULL,
    Email VARCHAR(100) NOT NULL,
    DepartmentID INT,
    EnrollmentYear INT DEFAULT 2024,
    CONSTRAINT PK_Students PRIMARY KEY (StudentID),
    CONSTRAINT UQ_Student_RegNo UNIQUE (RegistrationNo),
    CONSTRAINT UQ_Student_Email UNIQUE (Email),
    CONSTRAINT FK_Student_Department FOREIGN KEY (DepartmentID) 
        REFERENCES Departments(DepartmentID)
        ON UPDATE CASCADE
        ON DELETE SET NULL
);

-- Table 4: Enrollments (Junction Table)
-- Demonstrates:
-- - Composite Primary Key: (StudentID, CourseID)
-- - Dual Foreign Keys: Referencing Students and Courses
CREATE TABLE Enrollments (
    StudentID INT NOT NULL,
    CourseID INT NOT NULL,
    Semester VARCHAR(20) NOT NULL,
    Grade VARCHAR(2) DEFAULT 'IP', -- IP = In Progress
    CONSTRAINT PK_Enrollments PRIMARY KEY (StudentID, CourseID),
    CONSTRAINT FK_Enrollment_Student FOREIGN KEY (StudentID) 
        REFERENCES Students(StudentID) 
        ON DELETE CASCADE,
    CONSTRAINT FK_Enrollment_Course FOREIGN KEY (CourseID) 
        REFERENCES Courses(CourseID) 
        ON DELETE CASCADE
);

