-- ====================================================================
-- 5. LAB QUERIES (KEY LOOKUPS, CONSTRAINTS & RELATIONS)
-- ====================================================================

-- Query 1: Retrieve record using Primary Key lookup
SELECT * 
FROM Students 
WHERE StudentID = 1;

-- Query 2: Retrieve record using Candidate / Unique Key (Registration Number)
SELECT StudentID, RegistrationNo, FirstName, LastName, Email 
FROM Students 
WHERE RegistrationNo = '2024-SE-33';

-- Query 3: Foreign Key Relationship Query (Fetch students with department names)
SELECT 
    s.StudentID,
    s.RegistrationNo,
    CONCAT(s.FirstName, ' ', s.LastName) AS StudentName,
    d.DeptName,
    d.Location
FROM Students s
INNER JOIN Departments d ON s.DepartmentID = d.DepartmentID;

-- Query 4: Composite Key Retrieval (Fetch enrolled courses for student 2024-SE-33)
SELECT 
    s.RegistrationNo,
    CONCAT(s.FirstName, ' ', s.LastName) AS StudentName,
    c.CourseCode,
    c.CourseTitle,
    c.CreditHours,
    e.Semester,
    e.Grade
FROM Enrollments e
INNER JOIN Students s ON e.StudentID = s.StudentID
INNER JOIN Courses c ON e.CourseID = c.CourseID
WHERE s.RegistrationNo = '2024-SE-33';

-- Query 5: Find students not enrolled in any course (Outer Join demonstration)
SELECT 
    s.StudentID,
    s.RegistrationNo,
    s.FirstName,
    s.LastName
FROM Students s
LEFT JOIN Enrollments e ON s.StudentID = e.StudentID
WHERE e.CourseID IS NULL;
