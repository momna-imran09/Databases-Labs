DELIMITER //

CREATE PROCEDURE RegisterNewRental(
    IN p_CustomerID INT,
    IN p_VehicleID INT,
    IN p_RentalDate DATE,
    IN p_ReturnDate DATE
)
BEGIN
    DECLARE v_DailyRate DECIMAL(10,2);
    DECLARE v_Days INT;
    DECLARE v_TotalAmount DECIMAL(10,2);
    DECLARE v_Status VARCHAR(20);

    -- Check vehicle availability
    SELECT AvailabilityStatus, DailyRate INTO v_Status, v_DailyRate
    FROM Vehicles WHERE VehicleID = p_VehicleID;

    IF v_Status = 'Rented' THEN
        SIGNAL SQLSTATE '45000' 
        SET MESSAGE_TEXT = 'Error: Selected vehicle is already rented out.';
    ELSE
        -- Calculate rental days and total amount
        SET v_Days = DATEDIFF(p_ReturnDate, p_RentalDate);
        IF v_Days <= 0 THEN
            SET v_Days = 1; -- Minimum 1 day rental charge
        END IF;
        
        SET v_TotalAmount = v_Days * v_DailyRate;

        -- Insert into Rentals
        INSERT INTO Rentals (CustomerID, VehicleID, RentalDate, ReturnDate, TotalAmount, RentalStatus)
        VALUES (p_CustomerID, p_VehicleID, p_RentalDate, p_ReturnDate, v_TotalAmount, 'Active');

        -- Update vehicle status to Rented
        UPDATE Vehicles 
        SET AvailabilityStatus = 'Rented' 
        WHERE VehicleID = p_VehicleID;
        
        SELECT 'Rental registered successfully!' AS Message, v_TotalAmount AS CalculatedTotalAmount;
    END IF;
END //

DELIMITER ;

