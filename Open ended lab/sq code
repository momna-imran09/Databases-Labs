-- 5. TASK 3: JOIN QUERIES
-- ====================================================================

-- Query 1: Display customer name, vehicle number, model, rental date, and return date for every rental[cite: 1]
SELECT 
    c.CustomerName,
    v.VehicleNumber,
    v.VehicleModel,
    r.RentalDate,
    r.ReturnDate
FROM Rentals r
INNER JOIN Customers c ON r.CustomerID = c.CustomerID
INNER JOIN Vehicles v ON r.VehicleID = v.VehicleID;

-- Query 2: Display all customers and vehicles they rented (including customers with no rentals via LEFT JOIN)[cite: 1]
SELECT 
    c.CustomerName,
    c.CustomerPhone,
    COALESCE(v.VehicleNumber, 'No Vehicle Rented') AS VehicleNumber,
    COALESCE(v.VehicleModel, 'N/A') AS VehicleModel,
    r.RentalDate
FROM Customers c
LEFT JOIN Rentals r ON c.CustomerID = r.CustomerID
LEFT JOIN Vehicles v ON r.VehicleID = v.VehicleID;

-- Query 3: Display all vehicles and current rental info (including vehicles currently not rented)[cite: 1]
SELECT 
    v.VehicleNumber,
    v.VehicleModel,
    v.AvailabilityStatus,
    COALESCE(c.CustomerName, 'Not Currently Rented') AS CurrentRenter,
    r.RentalDate,
    r.ReturnDate
FROM Vehicles v
LEFT JOIN Rentals r ON v.VehicleID = r.VehicleID AND r.RentalStatus = 'Active'
LEFT JOIN Customers c ON r.CustomerID = c.CustomerID;

-- Query 4: Display total number of rentals made by each customer (including customers with 0 rentals)[cite: 1]
SELECT 
    c.CustomerID,
    c.CustomerName,
    COUNT(r.RentalID) AS TotalRentalsMade
FROM Customers c
LEFT JOIN Rentals r ON c.CustomerID = r.CustomerID
GROUP BY c.CustomerID, c.CustomerName;


