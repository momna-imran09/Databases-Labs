-- ====================================================================
-- 4. LAB QUERIES: NUMERIC FUNCTIONS IN ACTION
-- ====================================================================

-- Query 1: ROUND(), CEIL(), and FLOOR() Functions
-- Format budget amounts by rounding to 2 decimal places, ceiling, and flooring
SELECT 
    TaskTitle,
    BudgetAmount,
    ROUND(BudgetAmount, 2) AS RoundedBudget,
    CEIL(BudgetAmount) As CeilBudget,
    FLOOR(BudgetAmount) AS FloorBudget
FROM Project_Tasks;

-- Query 2: ABS() and MOD() Functions
-- Calculate absolute differences or remainder values (e.g., Budget modulo 100)
SELECT 
    TaskTitle,
    BudgetAmount,
    MOD(BudgetAmount, 100) AS BudgetModulo100
FROM Project_Tasks;


-- ====================================================================
-- 5. LAB QUERIES: DATE & TIME FUNCTIONS IN ACTION
-- ====================================================================

-- Query 3: CURRENT_DATE() and NOW() Functions
-- View system timestamps alongside task records
SELECT 
    TaskTitle,
    StartDate,
    CURRENT_DATE() AS CurrentSystemDate,
    NOW() AS CurrentSystemTimestamp
FROM Project_Tasks;

-- Query 4: DATEDIFF() Function
-- Calculate the total duration in days allocated for each task (Deadline - StartDate)
SELECT 
    RegistrationNo,
    TaskTitle,
    StartDate,
    DeadlineDate,
    DATEDIFF(DeadlineDate, StartDate) AS TotalTaskDays
FROM Project_Tasks;

-- Query 5: DATE_ADD() Function
-- Extend the deadline by 7 days for review purposes
SELECT 
    TaskTitle,
    DeadlineDate,
    DATE_ADD(DeadlineDate, INTERVAL 7 DAY) AS ExtendedDeadline
FROM Project_Tasks;

-- Query 6: YEAR(), MONTH(), and DAY() Extraction Functions
-- Extract specific components from the task start date
SELECT 
    TaskTitle,
    StartDate,
    YEAR(StartDate) AS StartYear,
    MONTH(StartDate) AS StartMonth,
    DAY(StartDate) AS StartDay
FROM Project_Tasks;
